{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "${workspaceFolder}/common.h",
                "${workspaceFolder}/BlockManager.h",
                "${workspaceFolder}/Timer.h",
                "${workspaceFolder}/bfilter.h",
                "${workspaceFolder}/rfilter.h",
                "${workspaceFolder}/BlockManager.cpp",
                "${workspaceFolder}/Timer.cpp",
                "${workspaceFolder}/bfilter.cpp",
                "${workspaceFolder}/rfilter.cpp",
                "${workspaceFolder}/query.cpp",
                "${workspaceFolder}/workloadAnalyzer.cpp",
                "${workspaceFolder}/main.cpp",
                "-o",
                "${workspaceFolder}/main"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build-workload-test",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-g",
                "-I${workspaceFolder}",
                "${workspaceFolder}/BlockManager.cpp",
                "${workspaceFolder}/Timer.cpp",
                "${workspaceFolder}/bfilter.cpp",
                "${workspaceFolder}/rfilter.cpp",
                "${workspaceFolder}/query.cpp",
                "${workspaceFolder}/workloadAnalyzer.cpp",
                "${workspaceFolder}/test/workload_analyzer_test.cpp",
                "-o",
                "${workspaceFolder}/test/workload_analyzer_test"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++ 生成活动文件",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ]
}